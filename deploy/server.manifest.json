{
  "project": "BackupKit",
  "profile": "server",
  "zip_prefix": "backupkit-server",
  "output_dir": "releases",
  "staging_dir": "var/build/deploy",
  "requires_public_html_in_zip": false,
  "include": [
    "module.php",
    "back/**",
    "bin/**",
    "core/**",
    "adapters/**",
    "lib/**"
  ],
  "exclude": [
    ".git/**",
    ".github/**",
    ".gitmodules",
    "docs/**",
    "tests/**",
    "examples/**",
    "scripts/**",
    "var/**",
    "releases/**",
    "**/__pycache__/**",
    "**/*.pyc",
    ".env",
    ".env.*",
    "*.log",
    "*.zip",
    "*.sql",
    "**/*.sql",
    "*.sql.gz",
    "**/*.sql.gz",
    "*.dump",
    "**/*.dump",
    "*.bak",
    "**/*.bak"
  ],
  "required_paths": [
    "module.php",
    "back/bootstrap.php",
    "bin/backupkit",
    "core/cli.py",
    "core/result.py",
    "core/backup.py",
    "adapters/mysql/adapter.py"
  ],
  "forbidden_paths": [
    ".git",
    ".github",
    ".gitmodules",
    ".env",
    "docs",
    "tests",
    "examples",
    "scripts",
    "var",
    "releases",
    "__pycache__",
    "*.sql",
    "*.sql.gz",
    "*.dump",
    "*.bak"
  ],
  "excluded_families": [
    "Git y CI",
    "documentacion y tests",
    "ejemplos y scripts locales",
    "secretos y configuracion real",
    "outputs, locks, caches y releases previas",
    "dumps y artefactos de backup"
  ],
  "submodules": {}
}
